#!/usr/bin/python3
"""Owner-local, interactive installation of the dedicated canary token."""
import base64
import getpass
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import warnings

BASE = Path("/etc/hoosh-runtimes/ingress-canary")
UNIT = "hoosh-ingress-canary-connector.service"

def decode(value, expected):
    if not isinstance(value, str) or not 80 <= len(value) <= 1024 or not re.fullmatch(r"[A-Za-z0-9+/_-]+={0,2}", value):
        raise ValueError("invalid format")
    data = json.loads(base64.b64decode(value + "=" * (-len(value) % 4), altchars=b"-_", validate=True))
    if not isinstance(data, dict) or data.get("a") != expected["account"] or data.get("t") != expected["tunnel"]:
        raise ValueError("wrong tunnel")
    secret = data.get("s")
    if not isinstance(secret, str) or len(base64.b64decode(secret, validate=True)) != 32:
        raise ValueError("invalid token secret")

def main():
    if os.geteuid() != 0 or len(sys.argv) != 1 or not sys.stdin.isatty() or not sys.stderr.isatty():
        raise ValueError("root and interactive terminal required")
    for p in (BASE, *BASE.parents):
        s = p.lstat()
        if not stat.S_ISDIR(s.st_mode) or s.st_uid != 0 or s.st_mode & 0o022:
            raise ValueError("untrusted path")
    scope = BASE / "expected-scope.json"
    fd = os.open(scope, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as f:
        s = os.fstat(f.fileno())
        if not stat.S_ISREG(s.st_mode) or s.st_uid != 0 or stat.S_IMODE(s.st_mode) != 0o600 or s.st_nlink != 1 or s.st_size > 512:
            raise ValueError("invalid scope file")
        expected = json.load(f)
    target = BASE / "token"
    if os.path.lexists(target):
        raise ValueError("token already installed; do not overwrite")
    warnings.simplefilter("error", getpass.GetPassWarning)
    value = getpass.getpass("Paste only the dedicated canary tunnel token (hidden): ").strip()
    decode(value, expected)
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(value)
        f.flush()
        os.fsync(f.fileno())
    del value
    print("CANARY_CREDENTIAL_INSTALLED. No DNS changed.")
    if subprocess.run(["/usr/bin/systemctl", "start", UNIT], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30).returncode:
        print("Connector start failed; credential retained securely for diagnosis.")
        return 2
    print("Connector start requested. Health and DNS must be verified separately.")
    return 0

if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError, getpass.GetPassWarning, EOFError, KeyboardInterrupt):
        sys.exit("Credential installation stopped; no credential printed.")
