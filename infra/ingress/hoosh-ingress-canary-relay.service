[Unit]
Description=Dedicated bounded TLS byte relay for canary
Requires=hoosh-web-gateway@hoosh-engine-canary.service
After=hoosh-web-gateway@hoosh-engine-canary.service
BindsTo=hoosh-web-gateway@hoosh-engine-canary.service

[Service]
User=hoosh-web-edge
Group=hoosh-web-edge
ExecStart=/lib/systemd/systemd-socket-proxyd --connections-max=8 /run/hoosh-gateway-hoosh-engine-canary/https.sock
NoNewPrivileges=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
UMask=0077
MemoryMax=24M
CPUQuota=10%
TasksMax=8
TimeoutStopSec=5
