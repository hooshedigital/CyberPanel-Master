[Unit]
Description=Private bounded relay to apache (%i)
Requires=hoosh-apache-http@%i.socket
After=hoosh-apache-http@%i.socket
BindsTo=hoosh-apache-http@%i.socket
ConditionPathExists=/etc/hoosh-runtimes/edge-accounts/apache-%i

[Service]
User=%i
ExecCondition=/usr/local/libexec/hoosh-edge-check apache %i
ExecStart=/lib/systemd/systemd-socket-proxyd --connections-max=8 /run/hoosh-apache-http-%i.sock
NoNewPrivileges=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
UMask=0077
Slice=hoosh-web-edge.slice
MemoryMax=24M
CPUQuota=10%
TasksMax=8
TimeoutStopSec=5
