#!/usr/bin/python3
"""Root-approved account and immutable project path; no provisioning."""
import os
import pwd
import grp
import re
import stat
import sys
from pathlib import Path

BASE = Path("/etc/hoosh-runtimes/frankenphp-accounts")

def trusted_dir(p):
    s = p.lstat()
    return stat.S_ISDIR(s.st_mode) and s.st_uid == 0 and not s.st_mode & 0o022

def private_project(u, public):
    # The dedicated account is the sole non-root reader of the project boundary.
    g = grp.getgrgid(u.pw_gid)
    if g.gr_name != u.pw_name or set(g.gr_mem) - {u.pw_name}:
        return False
    if any(x.pw_name != u.pw_name and (x.pw_gid == u.pw_gid or x.pw_uid == u.pw_uid)
           for x in pwd.getpwall()):
        return False
    if u.pw_shell not in ("/usr/sbin/nologin", "/sbin/nologin", "/bin/false"):
        return False
    for p in (public, public.parent):
        s = p.lstat()
        if (not stat.S_ISDIR(s.st_mode) or s.st_uid != 0
                or s.st_gid != u.pw_gid or stat.S_IMODE(s.st_mode) != 0o750
                or set(os.listxattr(p, follow_symlinks=False)) &
                {'system.posix_acl_access', 'system.posix_acl_default'}):
            return False
    return True


def check(name):
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,30}", name):
        return False
    if name in {"root", "ubuntu", "admin", "nobody", "www-data", "mysql", "redis"}:
        return False
    account = pwd.getpwnam(name)
    if not 1000 <= account.pw_uid < 65000 or account.pw_gid < 1000:
        return False
    if os.getuid() != account.pw_uid or os.getgid() != account.pw_gid:
        return False
    public = Path("/srv/hoosh-frankenphp") / name / "public"
    if not private_project(account, public):
        return False
    for p in (BASE, *BASE.parents, public, *public.parents):
        if not trusted_dir(p):
            return False
    fd = os.open(BASE / name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as f:
        s = os.fstat(f.fileno())
        if not stat.S_ISREG(s.st_mode) or s.st_uid != 0 or s.st_mode & 0o022 or s.st_size > 128:
            return False
        return f.read(129) == f"{name}:{account.pw_uid}:{account.pw_gid}\n".encode("ascii")

if __name__ == "__main__":
    try:
        ok = len(sys.argv) == 2 and check(sys.argv[1])
    except (OSError, KeyError, ValueError, OverflowError):
        ok = False
    sys.exit(0 if ok else 1)
