#!/usr/bin/python3
"""Dedicated TLS-over-Unix gateway config renderer and non-root verifier."""
import grp
import os
from pathlib import Path
import pwd
import re
import stat
import sys

BASE = Path("/etc/hoosh-runtimes")
EDGE = "hoosh-web-edge"
ENGINES = ("apache", "frankenphp")
DENIED = {"root", "ubuntu", "admin", "nobody", "www-data", "mysql", "redis", "cyberpanel", EDGE}


def validate(engine, account, domain):
    if engine not in ENGINES or account in DENIED or not re.fullmatch(r"[a-z][a-z0-9_-]{0,30}", account):
        raise ValueError("invalid engine/account")
    labels = domain.split(".")
    if (len(domain) > 253 or not domain.isascii() or len(labels) < 2
            or not re.fullmatch(r"[a-z][a-z0-9-]{0,62}", labels[-1])
            or any(not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", x) for x in labels)):
        raise ValueError("invalid domain")


def render(engine, account, domain):
    validate(engine, account, domain)
    r = "/run/hoosh-gateway-" + account
    c = str(BASE / "gateway-config" / account)
    upstream = "/run/hoosh-edge-" + engine + "-" + account + ".sock"
    return f"""worker_processes 1;
pid {r}/nginx.pid;
error_log stderr warn;
worker_rlimit_nofile 256;
events {{ worker_connections 64; }}
http {{
    access_log off;
    server_tokens off;
    client_header_timeout 10s;
    client_body_timeout 15s;
    send_timeout 15s;
    keepalive_timeout 5s;
    client_max_body_size 8m;
    client_body_buffer_size 16k;
    client_body_temp_path {r}/body;
    proxy_temp_path {r}/proxy;
    proxy_buffering off;
    proxy_request_buffering on;
    proxy_connect_timeout 3s;
    proxy_send_timeout 15s;
    proxy_read_timeout 30s;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:TLS:1m;
    upstream private_backend {{ server unix:{upstream}; }}
    server {{
        listen unix:{r}/https.sock ssl;
        server_name {domain};
        ssl_certificate {c}/cert.pem;
        ssl_certificate_key {c}/key.pem;
        if ($ssl_server_name != "{domain}") {{ return 421; }}
        if ($host != "{domain}") {{ return 421; }}
        if ($http_host !~ "^{domain.replace('.', '[.]')}(:443)?$") {{ return 421; }}
        if ($request_method !~ "^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$") {{ return 405; }}
        if ($http_upgrade != "") {{ return 400; }}
        location / {{
            proxy_pass http://private_backend;
            proxy_http_version 1.1;
            proxy_pass_request_headers off;
            proxy_set_header Host {domain};
            proxy_set_header X-Forwarded-Host {domain};
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Port 443;
            proxy_set_header Connection close;
            proxy_set_header Content-Type $http_content_type;
            proxy_set_header Accept $http_accept;
            proxy_set_header Accept-Language $http_accept_language;
            proxy_set_header User-Agent $http_user_agent;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Origin $http_origin;
            proxy_set_header Referer $http_referer;
            proxy_set_header If-None-Match $http_if_none_match;
            proxy_set_header If-Modified-Since $http_if_modified_since;
            proxy_set_header Range $http_range;
            proxy_cache off;
            proxy_redirect off;
        }}
    }}
}}
"""


def read_root_file(p, max_size, key_gid=None):
    for parent in p.parents:
        s = parent.lstat()
        if (not stat.S_ISDIR(s.st_mode) or s.st_uid != 0 or s.st_mode & 0o022
                or set(os.listxattr(parent, follow_symlinks=False)) &
                {"system.posix_acl_access", "system.posix_acl_default"}):
            raise ValueError("untrusted directory")
    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as f:
        s = os.fstat(f.fileno())
        if (not stat.S_ISREG(s.st_mode) or s.st_uid != 0 or s.st_nlink != 1
                or s.st_mode & 0o7022 or not 0 < s.st_size <= max_size
                or set(os.listxattr(fd)) & {"system.posix_acl_access", "system.posix_acl_default"}):
            raise ValueError("untrusted file")
        if key_gid is not None and (s.st_gid != key_gid or stat.S_IMODE(s.st_mode) != 0o640):
            raise ValueError("private key permissions")
        return f.read(max_size + 1)


def check(account):
    edge = pwd.getpwnam(EDGE)
    if os.getuid() != edge.pw_uid or os.getgid() != edge.pw_gid:
        return False
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,30}", account) or account in DENIED:
        return False
    if (edge.pw_uid == 0 or edge.pw_gid == 0 or grp.getgrgid(edge.pw_gid).gr_name != EDGE
            or set(grp.getgrgid(edge.pw_gid).gr_mem) - {EDGE}
            or edge.pw_shell not in ("/usr/sbin/nologin", "/sbin/nologin", "/bin/false")
            or any(x.pw_name != EDGE and (x.pw_uid == edge.pw_uid or x.pw_gid == edge.pw_gid)
                   for x in pwd.getpwall())
            or any(x.gr_gid != edge.pw_gid and EDGE in x.gr_mem for x in grp.getgrall())):
        return False
    d = BASE / "gateway-config" / account
    data = read_root_file(d / "route", 512).decode("ascii")
    engine, domain = data.rstrip("\n").split(":")
    if data != f"{engine}:{domain}\n":
        return False
    validate(engine, account, domain)
    u = pwd.getpwnam(account)
    backend = f"{account}:{u.pw_uid}:{u.pw_gid}\n".encode()
    permit = f"{engine}:{account}:{u.pw_uid}:{u.pw_gid}:{edge.pw_uid}:{edge.pw_gid}\n".encode()
    if read_root_file(BASE / (engine + "-accounts") / account, 128) != backend:
        return False
    if read_root_file(BASE / "edge-accounts" / (engine + "-" + account), 256) != permit:
        return False
    s = Path("/run/hoosh-edge-" + engine + "-" + account + ".sock").lstat()
    if not stat.S_ISSOCK(s.st_mode) or s.st_uid != edge.pw_uid or s.st_gid != edge.pw_gid or stat.S_IMODE(s.st_mode) != 0o600:
        return False
    read_root_file(d / "cert.pem", 65536)
    read_root_file(d / "key.pem", 16384, edge.pw_gid)
    return read_root_file(d / "nginx.conf", 32768) == render(engine, account, domain).encode()


if __name__ == "__main__":
    try:
        if len(sys.argv) == 5 and sys.argv[1] == "render":
            print(render(*sys.argv[2:]), end="")
            sys.exit(0)
        if len(sys.argv) == 3 and sys.argv[1] == "check":
            sys.exit(0 if check(sys.argv[2]) else 1)
    except (OSError, KeyError, ValueError, UnicodeError, OverflowError):
        pass
    sys.exit(1)
